-- Movement table definition
CREATE TABLE IF NOT EXISTS Movement (
    id TEXT PRIMARY KEY NOT NULL,
    tenantId TEXT NOT NULL,
    animalId TEXT NOT NULL,
    fromFarmId TEXT,
    toFarmId TEXT,
    movementDate TEXT NOT NULL,
    reason TEXT NOT NULL,
    notes TEXT,
    syncVersion INTEGER NOT NULL DEFAULT 0,
    isDeleted INTEGER AS Boolean NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    FOREIGN KEY (animalId) REFERENCES Animal(id),
    FOREIGN KEY (fromFarmId) REFERENCES Farm(id),
    FOREIGN KEY (toFarmId) REFERENCES Farm(id)
);

-- Indexes
CREATE INDEX IF NOT EXISTS idx_movement_animal ON Movement(tenantId, animalId);
CREATE INDEX IF NOT EXISTS idx_movement_farm ON Movement(tenantId, fromFarmId);
CREATE INDEX IF NOT EXISTS idx_movement_sync ON Movement(tenantId, syncVersion);

-- Queries
insertMovement:
INSERT OR REPLACE INTO Movement(id, tenantId, animalId, fromFarmId, toFarmId, movementDate, reason, notes, syncVersion, isDeleted, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getMovementById:
SELECT * FROM Movement WHERE id = ? AND isDeleted = 0;

getMovementsByAnimal:
SELECT * FROM Movement WHERE tenantId = ? AND animalId = ? AND isDeleted = 0 ORDER BY movementDate DESC;

getMovementsByFarm:
SELECT * FROM Movement WHERE tenantId = ? AND (fromFarmId = ? OR toFarmId = ?) AND isDeleted = 0 ORDER BY movementDate DESC;

updateMovement:
UPDATE Movement
SET fromFarmId = ?, toFarmId = ?, movementDate = ?, reason = ?, notes = ?, updatedAt = ?
WHERE id = ?;

softDeleteMovement:
UPDATE Movement
SET isDeleted = 1, updatedAt = ?
WHERE id = ?;
