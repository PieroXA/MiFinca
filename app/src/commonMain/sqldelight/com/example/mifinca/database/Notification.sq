-- Notification table definition
CREATE TABLE IF NOT EXISTS Notification (
    id TEXT PRIMARY KEY NOT NULL,
    tenantId TEXT NOT NULL,
    healthEventId TEXT,
    type TEXT NOT NULL,
    message TEXT NOT NULL,
    isRead INTEGER AS Boolean NOT NULL DEFAULT 0,
    scheduledDate TEXT NOT NULL,
    syncVersion INTEGER NOT NULL DEFAULT 0,
    isDeleted INTEGER AS Boolean NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    FOREIGN KEY (healthEventId) REFERENCES HealthEvent(id)
);

-- Indexes
CREATE INDEX IF NOT EXISTS idx_notification_tenant ON Notification(tenantId);
CREATE INDEX IF NOT EXISTS idx_notification_read ON Notification(tenantId, isRead);

-- Queries
insertNotification:
INSERT OR REPLACE INTO Notification(id, tenantId, healthEventId, type, message, isRead, scheduledDate, syncVersion, isDeleted, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getNotificationById:
SELECT * FROM Notification WHERE id = ? AND isDeleted = 0;

getUnreadNotifications:
SELECT * FROM Notification WHERE tenantId = ? AND isRead = 0 AND isDeleted = 0 ORDER BY scheduledDate ASC;

getAllNotifications:
SELECT * FROM Notification WHERE tenantId = ? AND isDeleted = 0 ORDER BY scheduledDate DESC;

markAsRead:
UPDATE Notification
SET isRead = 1, updatedAt = ?
WHERE id = ?;

softDeleteNotification:
UPDATE Notification
SET isDeleted = 1, updatedAt = ?
WHERE id = ?;

countUnreadNotifications:
SELECT COUNT(*) FROM Notification WHERE tenantId = ? AND isRead = 0 AND isDeleted = 0;
